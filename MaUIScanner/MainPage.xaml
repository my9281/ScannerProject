<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaUIScanner.MainPage" Title="{DynamicResource MobileTitle}" NavigationPage.HasNavigationBar="False" BackgroundColor="#F3F6FB">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="*,Auto" BackgroundColor="White">
            <VerticalStackLayout Spacing="2"><Label Text="{DynamicResource MobileBrand}" FontSize="22" FontAttributes="Bold" TextColor="#18243A"/><Label Text="{DynamicResource MobileTagline}" FontSize="10" TextColor="#8B96AA"/></VerticalStackLayout>
            <Button Grid.Column="1" Text="{DynamicResource Logout}" Command="{Binding LogoutCommand}" BackgroundColor="#EEF3FF" TextColor="#2457D6" CornerRadius="9" HeightRequest="42" Padding="16,0"/>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="620" HorizontalOptions="Fill">
                <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                    <Button Text="中文" CommandParameter="zh-CN" Clicked="LanguageButton_Clicked"/>
                    <Button Text="EN" CommandParameter="en-US" Clicked="LanguageButton_Clicked"/>
                    <Button Text="ES" CommandParameter="es-ES" Clicked="LanguageButton_Clicked"/>
                </HorizontalStackLayout>
                <Border Padding="14,9" BackgroundColor="#E8EEFC" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                    <HorizontalStackLayout Spacing="9"><Ellipse WidthRequest="8" HeightRequest="8" Fill="#35B879" VerticalOptions="Center"/><Label Text="{Binding OperatorText}" TextColor="#3A527C" FontSize="13"/></HorizontalStackLayout>
                </Border>
                <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"><Label Text="{DynamicResource MobileScan}" FontSize="17" FontAttributes="Bold" TextColor="#18243A"/><Label Grid.Column="1" Text="{DynamicResource MobileHint}" FontSize="12" TextColor="#647089" VerticalTextAlignment="Center"/></Grid>
                        <Border Padding="2" BackgroundColor="#F8FAFD" Stroke="#9CB5F5" StrokeThickness="2" StrokeShape="RoundRectangle 10">
                            <Entry x:Name="ScanEntry" Text="{Binding ScanCode}" Placeholder="{DynamicResource ScanPlaceholder}" ReturnType="Go" ReturnCommand="{Binding ProcessCommand}" FontSize="24" FontFamily="{DynamicResource AppFontFamily}" HeightRequest="64" IsEnabled="{Binding Busy, Converter={StaticResource InvertedBoolConverter}}"/>
                        </Border>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="{DynamicResource PrintCopiesLabel}" TextColor="#647089" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                            <Picker Grid.Column="1" SelectedIndex="{Binding PrintCopies}" ItemsSource="{DynamicResource PrintOptions}" Title="{DynamicResource PrintCopiesLabel}" HorizontalOptions="Fill"></Picker>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="纸张规格" TextColor="#647089" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding PaperSize}" HorizontalOptions="Fill" />
                        </Grid>
                        <Button Text="{DynamicResource ProcessScanLabel}" Command="{Binding ProcessCommand}" HeightRequest="50" BackgroundColor="#2457D6" TextColor="White" FontAttributes="Bold" CornerRadius="10"/>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="11">
                        <Label Text="{DynamicResource ProcessingStatusTitle}" FontSize="14" TextColor="#647089" FontAttributes="Bold"/>
                        <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="19" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                        <ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" Color="#2457D6" HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{DynamicResource RuntimeInformation}" FontSize="17" FontAttributes="Bold" TextColor="#18243A"/>
                        <Label Text="{Binding CountText}" TextColor="#2457D6" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding ServiceText}" TextColor="#647089"/>
                        <Label Text="{Binding LastRefreshText}" TextColor="#647089"/>
                        <Label Text="{Binding LogText}" TextColor="#8B96AA" FontSize="11" LineBreakMode="MiddleTruncation"/>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Button Text="{DynamicResource RefreshOrders}" Command="{Binding RefreshCommand}" HeightRequest="48" BackgroundColor="#EEF3FF" TextColor="#2457D6" CornerRadius="10"/>
                    <Button Grid.Column="1" Text="{DynamicResource ImportUrgentCsv}" Command="{Binding ImportCommand}" HeightRequest="48" BackgroundColor="#EEF3FF" TextColor="#2457D6" CornerRadius="10"/>
                    <Button Grid.Row="1" Text="{DynamicResource OpenScanLogMobile}" Command="{Binding OpenLogCommand}" HeightRequest="48" BackgroundColor="#F2F5FA" TextColor="#18243A" CornerRadius="10"/>
                    <Button Grid.Row="1" Grid.Column="1" Text="{DynamicResource UploadScanLog}" Command="{Binding UploadCommand}" HeightRequest="48" BackgroundColor="#F2F5FA" TextColor="#18243A" CornerRadius="10"/>
                </Grid>
                <Button Text="入库检测 / 出库检测 / 库位费比对" Clicked="OperationsButton_Clicked" HeightRequest="50" BackgroundColor="#18243A" TextColor="White" CornerRadius="10" />
                <Label Text="{DynamicResource MobilePlatformHint}" HorizontalTextAlignment="Center" TextColor="#8B96AA" FontSize="11" Margin="0,4,0,18"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
