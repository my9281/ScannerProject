<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaUIScanner.MainPage"
             Title="{Binding Title}"
             BackgroundColor="#F3F6FB">
    <ScrollView>
        <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18" MaximumWidthRequest="1000" HorizontalOptions="Center">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" TextColor="#18243A"/>
                    <Label Text="{Binding OfflineText}" FontSize="13" TextColor="#647089"/>
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <Button Text="中" Command="{Binding ChangeLanguageCommand}" CommandParameter="zh-CN" Padding="12,6"/>
                    <Button Text="EN" Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US" Padding="12,6"/>
                    <Button Text="ES" Command="{Binding ChangeLanguageCommand}" CommandParameter="es-ES" Padding="12,6"/>
                </HorizontalStackLayout>
            </Grid>
            <Border Grid.Row="1" Padding="22" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ScanTitle}" FontSize="17" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="{Binding Hint}" FontSize="12" TextColor="#647089"/>
                    </Grid>
                    <Entry x:Name="ScanEntry" Text="{Binding ScanCode}" ReturnType="Go" ReturnCommand="{Binding ProcessCommand}" FontSize="25" FontFamily="Consolas" HeightRequest="64" IsEnabled="{Binding Busy, Converter={StaticResource InvertedBoolConverter}}"/>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <HorizontalStackLayout>
                            <CheckBox IsChecked="{Binding AutoPrint}"/>
                            <Label Text="{Binding AutoPrintText}" VerticalTextAlignment="Center"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="{Binding OpenLogText}" Command="{Binding OpenLogCommand}"/>
                        <Button Grid.Column="2" Text="{Binding PrintText}" Command="{Binding ProcessCommand}" BackgroundColor="#2457D6" TextColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="18">
                <Border Padding="20" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding RuntimeText}" FontSize="17" FontAttributes="Bold"/>
                        <Label Text="{Binding PrinterText}" TextColor="#647089"/>
                        <Label Text="{Binding LogText}" TextColor="#647089" LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding CountText}" TextColor="#2457D6" FontSize="17" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="20" BackgroundColor="White" Stroke="{Binding StatusColor}" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="{Binding StatusTitle}" TextColor="#647089"/>
                        <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="20" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>
            <Border Grid.Row="3" Padding="14" BackgroundColor="#E9EEF7" StrokeShape="RoundRectangle 11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="#35B879" VerticalOptions="Center"/>
                        <Label Text="{Binding OfflineText}" TextColor="#647089"/>
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="{Binding ImportText}" Command="{Binding ImportCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
