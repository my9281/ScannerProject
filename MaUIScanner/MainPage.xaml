<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaUIScanner.MainPage"
             Title="幽梦运单之星扫描系统"
             BackgroundColor="#F3F6FB">
    <Grid Padding="28" RowDefinitions="*,Auto,*" MaximumWidthRequest="760" HorizontalOptions="Center">
        <Border Grid.Row="1" Padding="28" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="16">
                <Entry x:Name="ScanEntry"
                       Text="{Binding ScanCode}"
                       Placeholder="请扫描编号"
                       ReturnType="Go"
                       ReturnCommand="{Binding ProcessCommand}"
                       FontSize="27"
                       FontFamily="Consolas"
                       HeightRequest="68"
                       IsEnabled="{Binding Busy, Converter={StaticResource InvertedBoolConverter}}"/>
                <Button Text="导出扫描记录"
                        Command="{Binding ExportCommand}"
                        HeightRequest="48"
                        BackgroundColor="#2457D6"
                        TextColor="White"
                        FontAttributes="Bold"/>
                <Label Text="{Binding ScanHint}"
                       TextColor="{Binding HintColor}"
                       FontSize="15"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
