<UserControl x:Class="Scanner.WPF.Views.SkuSerialLabelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EAF3F7" FontWeight="Bold">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SKU / SN 二维码标签" FontSize="30" Foreground="#082F4D"/>
            <TextBlock Text="输入标签内容，打印一张 4 × 6 横向双二维码标签" FontSize="18" Foreground="#315D7A" Margin="0,5,0,18"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="SKU" FontSize="20" VerticalAlignment="Center"/>
            <TextBox x:Name="SkuInput" Grid.Column="1" Height="52" Padding="12,0" VerticalContentAlignment="Center" MaxLength="200"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="SN" FontSize="20" VerticalAlignment="Center"/>
            <TextBox x:Name="SerialNumberInput" Grid.Column="1" Height="52" Padding="12,0" VerticalContentAlignment="Center" MaxLength="200"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="备注" FontSize="20" VerticalAlignment="Center"/>
            <TextBox x:Name="RemarkInput" Grid.Column="1" Height="74" Padding="12,8" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="200"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="110,16,0,0">
            <Button Content="打印 4 × 6 标签" Padding="24,10" Click="Print_Click" IsDefault="True"/>
            <Button Content="清空" Padding="20,10" Margin="12,0,0,0" Click="Clear_Click"/>
        </StackPanel>

        <Border Grid.Row="5" Background="White" BorderBrush="#79A9C4" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="等待输入" FontSize="21" Foreground="#0B5F99"/>
                <TextBlock Text="标签布局：左侧 SKU 二维码，右侧 SN/MESSN 二维码，底部为备注。" FontSize="15" Foreground="#315D7A" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
