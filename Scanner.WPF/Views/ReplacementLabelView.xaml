<UserControl x:Class="Scanner.WPF.Views.ReplacementLabelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#EAF3F7" FontWeight="Bold">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{DynamicResource WpfComplete038}" FontSize="30" Foreground="#082F4D"/><TextBlock Text="{DynamicResource WpfComplete093}" FontSize="18" Foreground="#315D7A" Margin="0,5,0,14"/></StackPanel>
  <TextBox x:Name="ScanInput" Grid.Row="1" Height="58" FontSize="27" Padding="14,0" VerticalContentAlignment="Center" KeyDown="ScanInput_KeyDown" InputMethod.IsInputMethodEnabled="False"/>
  <GroupBox Grid.Row="2" Header="{DynamicResource WpfComplete094}" FontSize="18" Padding="10" Margin="0,14,0,10"><WrapPanel>
   <CheckBox Content="{DynamicResource WpfComplete095}" Tag="检测OK" IsChecked="True" Margin="10,6"/><CheckBox Content="M1" Tag="M1" Margin="10,6"/><CheckBox Content="M2" Tag="M2" Margin="10,6"/><CheckBox Content="M3" Tag="M3" Margin="10,6"/><CheckBox Content="U1" Tag="U1" Margin="10,6"/><CheckBox Content="U2" Tag="U2" Margin="10,6"/><CheckBox Content="U3" Tag="U3" Margin="10,6"/><CheckBox Content="Box" Tag="Box" Margin="10,6"/><CheckBox Content="{DynamicResource WpfComplete096}" Tag="线材" Margin="10,6"/><CheckBox Content="{DynamicResource WpfComplete097}" Tag="包材" Margin="10,6"/>
   <CheckBox x:Name="RepairOption" Content="{DynamicResource WpfComplete098}" Margin="24,6,10,6" Foreground="#9B1C1C"/>
  </WrapPanel></GroupBox>
  <StackPanel Grid.Row="3" Orientation="Horizontal"><TextBlock Text="{DynamicResource WpfComplete099}" VerticalAlignment="Center"/><RadioButton x:Name="WidePaper" Content="4 × 6" IsChecked="True" Margin="5"/><RadioButton Content="4 × 4" Margin="5"/><Button Content="{DynamicResource WpfComplete100}" Padding="18,8" Margin="18,0,8,0" Click="Print_Click"/><Button Content="{DynamicResource WpfOpenTxt}" Padding="14,8" Margin="4,0" Click="OpenLog_Click"/><Button Content="{DynamicResource OpenScanWorkbook}" Padding="14,8" Margin="4,0" Click="OpenExcel_Click"/><Button Content="{DynamicResource NewRecordFiles}" Padding="14,8" Margin="4,0" Click="NewFiles_Click"/><Button Content="{DynamicResource WpfComplete101}" Padding="14,8" Margin="4,0" Click="Upload_Click"/></StackPanel>
  <Border Grid.Row="4" Background="White" BorderBrush="#79A9C4" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="StatusText" Text="{DynamicResource WaitingForScan}" FontSize="21" Foreground="#0B5F99"/><TextBlock x:Name="FileText" FontSize="15" Foreground="#315D7A" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock x:Name="CountText" FontSize="18" Foreground="#082F4D" Margin="0,8,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
