<Window x:Class="Scanner.WPF.OutboundInspectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="{DynamicResource Logo}" Title="{DynamicResource OutboundTitle}" Width="1120" Height="720" MinWidth="1020" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#EAF3F7" FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2457D6"/><SolidColorBrush x:Key="TextPrimaryBrush" Color="#082F4D"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="#315D7A"/><SolidColorBrush x:Key="BorderBrush" Color="#DDE4F0"/>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="16,0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#F2F5FA"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="3,0,3,16"><TextBlock Text="{DynamicResource OutboundTitle}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="{DynamicResource OutboundHint}" Margin="0,5,0,0" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="TextFileTextBlock" Text="{DynamicResource TextNotSelected}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="BaseFileTextBlock" Text="{DynamicResource BaseWorkbookNotSelected}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource SelectText}" Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="SelectTextButton_Click"/>
        </Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="{DynamicResource PalletNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="18" Margin="0,0,0,6"/><TextBox x:Name="PalletNumberTextBox" Height="42" FontSize="21" Padding="10,7"/></StackPanel>
            <Button x:Name="PrintButton" Grid.Column="1" Content="{DynamicResource PrintSkuSummary}" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="PrintButton_Click" IsEnabled="False"/>
            <Button x:Name="ExportButton" Grid.Column="2" Content="{DynamicResource ExportDetailXlsx}" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="ExportButton_Click" IsEnabled="False"/>
            <Button x:Name="UploadButton" Grid.Column="3" Content="{DynamicResource UploadShelvedPallet}" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Background="#16835D" Foreground="White" Click="UploadButton_Click" IsEnabled="False"/>
        </Grid></Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="SummaryTextBlock" Text="{DynamicResource SelectTextAndBase}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <DataGrid x:Name="ResultDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" RowHeight="34" AlternatingRowBackground="#FFFFFF"><DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource RowNumber}" Binding="{Binding Number}" Width="65"/><DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="190"/><DataGridTextColumn Header="{DynamicResource SkuText}" Binding="{Binding Sku}" Width="250"/><DataGridTextColumn Header="{DynamicResource TypeColumn}" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="{DynamicResource ProcessingMethod}" Binding="{Binding ProcessingMethod}" Width="120"/><DataGridTextColumn Header="{DynamicResource ProcessingDate}" Binding="{Binding ProcessingTime}" Width="*"/>
            </DataGrid.Columns></DataGrid>
        </Grid></Border>
    </Grid>
</Window>
