<Window x:Class="Scanner.WPF.MonthlyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="月报导出" Width="580" Height="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#EAF3F7" FontFamily="{DynamicResource AppFontFamily}">
    <StackPanel Margin="28">
        <TextBlock Text="月报导出" FontSize="28" FontWeight="Bold" Foreground="#082F4D"/>
        <TextBlock Text="按基础表中的处理时间筛选，保留全部明细字段。" Margin="0,12,0,18" FontSize="16"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="年份" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="YearBox" Width="120" IsEditable="True"/>
            <TextBlock Text="月份" VerticalAlignment="Center" Margin="24,0,10,0"/>
            <ComboBox x:Name="MonthBox" Width="100"/>
        </StackPanel>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="导出月度总表及待检测、检测、翻新、维修、报废分类表。两个一件代发表和月份出入库表仅保留表头。"/>
        <TextBlock Text="可选附加表：按处理时间筛选年月，合并物料申领明细，按 SKU 汇总数量。" TextWrapping="Wrap" Margin="0,14,0,8"/>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="DetectionUploadButton" Content="上传 InboundDetection" Click="UploadDetection_Click" Width="195" DockPanel.Dock="Left"/>
            <TextBlock x:Name="DetectionFileText" Text="未上传" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <DockPanel>
            <Button x:Name="MaintenanceUploadButton" Content="上传 ProductMaintenance" Click="UploadMaintenance_Click" Width="195" DockPanel.Dock="Left"/>
            <TextBlock x:Name="MaintenanceFileText" Text="未上传" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button x:Name="ExportButton" Content="导出 Excel" Click="Export_Click" Height="40" Width="150" HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
