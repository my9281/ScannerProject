<Window Icon="{DynamicResource Logo}" x:Class="Scanner.WPF.MonthlyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WpfComplete046}" Width="700" Height="680" MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="#EAF3F7" FontFamily="{DynamicResource AppFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
        <TextBlock Text="{DynamicResource WpfComplete046}" FontSize="28" FontWeight="Bold" Foreground="#082F4D"/>
        <TextBlock Text="{DynamicResource WpfComplete062}" Margin="0,12,0,18" FontSize="16" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource WpfComplete063}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="YearBox" Width="120" IsEditable="True"/>
            <TextBlock Text="{DynamicResource WpfComplete064}" VerticalAlignment="Center" Margin="24,0,10,0"/>
            <ComboBox x:Name="MonthBox" Width="100"/>
        </StackPanel>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Text="{DynamicResource WpfComplete065}"/>
        <TextBlock Text="{DynamicResource WpfComplete066}" TextWrapping="Wrap" Margin="0,14,0,8"/>
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="DetectionUploadButton" Content="{DynamicResource WpfComplete067}" Click="UploadDetection_Click" MinWidth="195" Padding="12,5" DockPanel.Dock="Left"/>
            <TextBlock x:Name="DetectionFileText" Text="{DynamicResource WpfComplete068}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <DockPanel>
            <Button x:Name="MaintenanceUploadButton" Content="{DynamicResource WpfComplete069}" Click="UploadMaintenance_Click" MinWidth="195" Padding="12,5" DockPanel.Dock="Left"/>
            <TextBlock x:Name="MaintenanceFileText" Text="{DynamicResource WpfComplete068}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button x:Name="ExportButton" Content="{DynamicResource WpfComplete004}" Click="Export_Click" Height="40" MinWidth="150" Padding="12,0" HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </StackPanel></ScrollViewer>
</Window>
