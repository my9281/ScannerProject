<Window x:Class="Scanner.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="{DynamicResource Logo}"
        Title="{DynamicResource WindowTitle}"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="620"
        ResizeMode="NoResize"
        Background="#F3F6FB"
        FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2457D6"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D46AE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18243A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#647089"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE4F0"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.08" Color="#15223A"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#F2F5FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="LanguageButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="OptionRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="62"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="White"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#F0F4FC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#E6EDFF"/>
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OptionBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#E8EEFC" CornerRadius="16" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#35B879" Margin="0,0,8,0"/>
                    <TextBlock x:Name="OperatorTextBlock" Text="{Binding OperatorText}" Foreground="#3A527C" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource MainTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource MainTagline}" Foreground="#8B96AA" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
            </Viewbox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="中" ToolTip="中文" Style="{StaticResource LanguageButtonStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="zh-CN"/>
                <Button Content="EN" ToolTip="English" Style="{StaticResource LanguageButtonStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US"/>
                <Button Content="ES" ToolTip="Español" Style="{StaticResource LanguageButtonStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="es-ES"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <TextBlock Text="{DynamicResource ScanInputTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource ScanHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" Background="#F8FAFD" BorderBrush="#9CB5F5" BorderThickness="2" CornerRadius="10">
                    <TextBox x:Name="SnTextBox"
                             Height="64"
                             Padding="16,0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource PrimaryBrush}"
                             FontFamily="{DynamicResource AppFontFamily}"
                             FontSize="27"
                             FontWeight="SemiBold"
                             Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsInputEnabled}"
                             GotKeyboardFocus="ScanTextBox_GotKeyboardFocus"
                             VerticalContentAlignment="Center"
                             InputMethod.IsInputMethodEnabled="False">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ProcessScanCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>
                <WrapPanel Grid.Row="2" Margin="2,8,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,0">
                        <TextBlock Text="{DynamicResource AutoPrint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <Border Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{DynamicResource PrintNone}" Style="{StaticResource OptionRadioButtonStyle}" GroupName="PrintCopies" IsChecked="{Binding IsPrintDisabled, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled}"/>
                                <RadioButton Content="{DynamicResource PrintOnce}" Style="{StaticResource OptionRadioButtonStyle}" GroupName="PrintCopies" IsChecked="{Binding IsPrintOnce, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled}"/>
                                <RadioButton Content="{DynamicResource PrintTwice}" Style="{StaticResource OptionRadioButtonStyle}" GroupName="PrintCopies" IsChecked="{Binding IsPrintTwice, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource LabelSizeSettingLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="18,0,7,0" VerticalAlignment="Center"/>
                        <Border Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="4 × 6" Style="{StaticResource OptionRadioButtonStyle}" GroupName="LabelPaperSize" IsChecked="{Binding IsWideLabelPaper, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled}"/>
                                <RadioButton Content="4 × 4" Style="{StaticResource OptionRadioButtonStyle}" GroupName="LabelPaperSize" IsChecked="{Binding IsSquareLabelPaper, Mode=TwoWay}" IsEnabled="{Binding IsInputEnabled}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="OpenLogButton" Content="{DynamicResource OpenScanLog}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Command="{Binding OpenLogCommand}"/>
                        <Button x:Name="UploadLogButton" Content="{DynamicResource UploadScanLog}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Command="{Binding UploadLogCommand}"/>
                        <Button x:Name="PrintButton" Content="{DynamicResource PrintTwoCopies}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="132" Command="{Binding ProcessScanCommand}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,9,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource RuntimeInformation}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <TextBlock Text="{Binding LabelInformationText}" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Text="{Binding CopiesInformationText}" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="PrinterTextBlock" Text="{Binding PrinterText}" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="LogFileTextBlock" Text="{Binding LogFileText}" Style="{StaticResource InfoLabelStyle}"/>
                    </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" x:Name="CountTextBlock" Text="{Binding CountText}" Foreground="{StaticResource PrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,8,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22" Margin="9,0,0,0" BorderBrush="{Binding StatusBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource ProcessingStatusTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" x:Name="StatusTextBlock" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,14,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#E9EEF7" CornerRadius="11" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#35B879" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource ServiceStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WebStatus" Text="{Binding WebStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource LastRefreshLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WebLastTime" Text="{Binding WebLastTime}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <UniformGrid Grid.Row="1" Columns="6" Margin="-4,8,-4,0">
                    <Button x:Name="GlobalBaseButton" Content="{DynamicResource GlobalBaseImport}" Style="{StaticResource BaseButtonStyle}" Height="36" Margin="4,0" Click="ImportGlobalBase_Click"/>
                    <Button Content="{DynamicResource FooterLocationFee}" ToolTip="{DynamicResource LocationFeeTitle}" Style="{StaticResource BaseButtonStyle}" Height="36" Margin="4,0" Click="OpenLocationFeeComparisonButton_Click"/>
                    <Button Content="{DynamicResource FooterOutbound}" ToolTip="{DynamicResource OutboundTitle}" Style="{StaticResource BaseButtonStyle}" Height="36" Margin="4,0" Click="OpenOutboundInspectionButton_Click"/>
                    <Button Content="{DynamicResource FooterInbound}" ToolTip="{DynamicResource InboundTitle}" Style="{StaticResource BaseButtonStyle}" Height="36" Margin="4,0" Click="OpenChecklistButton_Click"/>
                    <Button x:Name="ImportUrgentWorkOrdersButton" Content="{DynamicResource FooterImportUrgent}" ToolTip="{DynamicResource ImportUrgentWorkOrders}" Style="{StaticResource BaseButtonStyle}" Height="36" Margin="4,0" Command="{Binding ImportUrgentWorkOrdersCommand}"/>
                    <Button Content="{DynamicResource FooterRefresh}" ToolTip="{DynamicResource ManualRefresh}" Style="{StaticResource BaseButtonStyle}" Height="36" Margin="4,0" Command="{Binding RefreshCommand}"/>
                    <Button Content="{DynamicResource DailyReport}" Style="{StaticResource BaseButtonStyle}" Height="36" Margin="4,0" Click="CreateDailyReportButton_Click"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
