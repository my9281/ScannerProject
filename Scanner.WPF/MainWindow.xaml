<Window x:Class="Scanner.WPF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Scanner.WPF.Views"
 Icon="{DynamicResource Logo}" Title="{DynamicResource WindowTitle}" Width="1200" Height="800" MinWidth="1020" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#EAF3F7" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#082F4D"/>
        <SolidColorBrush x:Key="Blue" Color="#0B5F99"/>
        <SolidColorBrush x:Key="Muted" Color="#315D7A"/>
        <SolidColorBrush x:Key="Line" Color="#79A9C4"/>
        <Style x:Key="FeatureCard" TargetType="Button">
            <Setter Property="MinHeight" Value="140"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#DDEEF5"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="card" Property="Opacity" Value=".72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="39"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FeatureTitle" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="FeatureDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="DirectoryPanel" Margin="36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource WpfComplete033}" FontSize="36" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="{DynamicResource WpfComplete034}" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,6,0,18"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"><Border  Background="#DCECF3" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="15,9">
                    <TextBlock Text="{Binding OperatorText}" FontSize="18" Foreground="{StaticResource Ink}"/>
                </Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="中文" Tag="zh-CN" Padding="10,4" Margin="4,0" Click="DirectoryLanguage_Click"/><Button Content="English" Tag="en-US" Padding="10,4" Margin="4,0" Click="DirectoryLanguage_Click"/><Button Content="Español" Tag="es-ES" Padding="10,4" Margin="4,0" Click="DirectoryLanguage_Click"/></StackPanel></StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <GroupBox Header="{DynamicResource DirectoryBaseData}">
                        <WrapPanel Orientation="Horizontal" ItemWidth="350">
<Button ToolTip="{DynamicResource WpfComplete049}" x:Name="GlobalBaseButton" Style="{StaticResource FeatureCard}" Click="ImportGlobalBase_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WpfComplete048}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete049}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
<Button ToolTip="{DynamicResource WpfComplete059}" x:Name="ImportUrgentWorkOrdersButton" Style="{StaticResource FeatureCard}" Command="{Binding ImportUrgentWorkOrdersCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WpfComplete058}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete059}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
<Button ToolTip="{DynamicResource WpfComplete060}" Style="{StaticResource FeatureCard}" Command="{Binding RefreshCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FooterRefresh}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete060}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource DirectoryInbound}">
                        <WrapPanel Orientation="Horizontal" ItemWidth="350">
<Button ToolTip="{DynamicResource WpfComplete037}" Style="{StaticResource FeatureCard}" Click="OpenScanView_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WpfComplete036}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete037}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource DirectoryGoodStock}">
                        <WrapPanel Orientation="Horizontal" ItemWidth="350">
<Button ToolTip="{DynamicResource WpfComplete045}" Style="{StaticResource FeatureCard}" Click="OpenAutomaticMatching_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE8AB;" Style="{StaticResource FeatureIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource WpfComplete001}" Style="{StaticResource FeatureTitle}"/>
                                    <TextBlock Text="{DynamicResource WpfComplete045}" Style="{StaticResource FeatureDescription}"/>
                                </StackPanel></Grid></Button>
<Button ToolTip="{DynamicResource WpfComplete050}" Style="{StaticResource FeatureCard}" Click="OpenChecklistButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE896;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FooterInbound}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete050}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
<Button ToolTip="{DynamicResource WpfComplete039}" Style="{StaticResource FeatureCard}" Click="OpenReplacementView_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WpfComplete038}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete039}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
<Button ToolTip="{DynamicResource WpfComplete043}" Style="{StaticResource FeatureCard}" Click="OpenGoodArea_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE7C1;" Style="{StaticResource FeatureIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource WpfComplete027}" Style="{StaticResource FeatureTitle}"/>
                <TextBlock Text="{DynamicResource WpfComplete043}" Style="{StaticResource FeatureDescription}"/>
            </StackPanel></Grid></Button>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource DirectoryShelving}">
                        <WrapPanel Orientation="Horizontal" ItemWidth="350">
<Button ToolTip="{DynamicResource WpfComplete041}" Style="{StaticResource FeatureCard}" Click="OpenSkuSerialLabelView_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WpfComplete040}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete041}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
<Button ToolTip="{DynamicResource WpfComplete051}" Style="{StaticResource FeatureCard}" Click="OpenOutboundInspectionButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE898;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource FooterOutbound}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete051}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Header="{DynamicResource DirectoryReports}">
                        <WrapPanel Orientation="Horizontal" ItemWidth="350">
<Button ToolTip="{DynamicResource WpfComplete057}" Style="{StaticResource FeatureCard}" Click="CreateDailyReportButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource DailyReport}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete057}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
<Button ToolTip="{DynamicResource WpfComplete047}" Style="{StaticResource FeatureCard}" Click="OpenMonthlyReport_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource WpfComplete046}" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="{DynamicResource WpfComplete047}" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
<Button ToolTip="{DynamicResource WpfComplete055}" Style="{StaticResource FeatureCard}" Click="OpenBatchLabel_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE749;" Style="{StaticResource FeatureIcon}"/><StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource WpfComplete012}" Style="{StaticResource FeatureTitle}"/>
                                    <TextBlock Text="{DynamicResource WpfComplete055}" Style="{StaticResource FeatureDescription}"/>
                                </StackPanel></Grid></Button>
                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="ScanPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="{DynamicResource WpfComplete061}" HorizontalAlignment="Left" Margin="18,12,0,6" Padding="15,7" FontSize="18" Click="BackToDirectory_Click"/>
            <views:ScanView x:Name="ScanContent" Grid.Row="1"/>
        </Grid>
        <Grid x:Name="ReplacementPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="{DynamicResource WpfComplete061}" HorizontalAlignment="Left" Margin="18,12,0,6" Padding="15,7" FontSize="18" Click="BackToDirectory_Click"/>
            <views:ReplacementLabelView Grid.Row="1"/>
        </Grid>
        <Grid x:Name="SkuSerialLabelPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="{DynamicResource WpfComplete061}" HorizontalAlignment="Left" Margin="18,12,0,6" Padding="15,7" FontSize="18" Click="BackToDirectory_Click"/>
            <views:SkuSerialLabelView Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
