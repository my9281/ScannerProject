<Window x:Class="Scanner.WPF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Scanner.WPF.Views"
 Icon="{DynamicResource Logo}" Title="{DynamicResource WindowTitle}" Width="1200" Height="800" MinWidth="1020" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#EAF3F7" FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#082F4D"/>
        <SolidColorBrush x:Key="Blue" Color="#0B5F99"/>
        <SolidColorBrush x:Key="Muted" Color="#315D7A"/>
        <SolidColorBrush x:Key="Line" Color="#79A9C4"/>
        <Style x:Key="FeatureCard" TargetType="Button">
            <Setter Property="Height" Value="112"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#DDEEF5"/>
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="card" Property="Opacity" Value=".72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="39"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FeatureTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="FeatureDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="DirectoryPanel" Margin="36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="功能目录" FontSize="36" Foreground="{StaticResource Ink}"/>
                    <TextBlock Text="请选择需要使用的功能" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,6,0,18"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#DCECF3" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="15,9">
                    <TextBlock Text="{Binding OperatorText}" FontSize="18" Foreground="{StaticResource Ink}"/>
                </Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <GroupBox Header="标签管理">
                        <WrapPanel Orientation="Horizontal" ItemWidth="350">
                            <Button Style="{StaticResource FeatureCard}" Click="OpenScanView_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="扫码打印" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="扫描 SN 或 OID，记录并打印标签" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource FeatureCard}" Click="OpenReplacementView_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="替换标签" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="独立记录扫码数据，并按所选描述打印替换标签" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource FeatureCard}" Click="OpenSkuSerialLabelView_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="SKU / SN 标签" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="打印带两个二维码和备注的 4 × 6 标签" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </GroupBox >
                    <GroupBox Header="出入库管理">
                        <WrapPanel  Orientation="Horizontal" ItemWidth="350">
                            <Button x:Name="GlobalBaseButton" Style="{StaticResource FeatureCard}" Click="ImportGlobalBase_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="导入基础表" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="加载全局基础 Excel 数据" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource FeatureCard}" Click="OpenChecklistButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE896;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="入库检测" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="匹配入库 SN、检测状态并导出结果" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource FeatureCard}" Click="OpenOutboundInspectionButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE898;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="出库检测" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="核对出库数据并打印汇总标签" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Header="其他功能">
                        <WrapPanel  Orientation="Horizontal" ItemWidth="350">
                            <Button Style="{StaticResource FeatureCard}" Click="CreateDailyReportButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="日报" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="生成并打开当天扫描日报" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="ImportUrgentWorkOrdersButton" Style="{StaticResource FeatureCard}" Command="{Binding ImportUrgentWorkOrdersCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="导入工单" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="导入紧急工单及运单关联规则" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource FeatureCard}" Command="{Binding RefreshCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource FeatureIcon}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="手动刷新" Style="{StaticResource FeatureTitle}"/>
                                        <TextBlock Text="重新获取在线工单与备注数据" Style="{StaticResource FeatureDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="ScanPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="← 返回功能目录" HorizontalAlignment="Left" Margin="18,12,0,6" Padding="15,7" FontSize="18" Click="BackToDirectory_Click"/>
            <views:ScanView x:Name="ScanContent" Grid.Row="1"/>
        </Grid>
        <Grid x:Name="ReplacementPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="← 返回功能目录" HorizontalAlignment="Left" Margin="18,12,0,6" Padding="15,7" FontSize="18" Click="BackToDirectory_Click"/>
            <views:ReplacementLabelView Grid.Row="1"/>
        </Grid>
        <Grid x:Name="SkuSerialLabelPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Content="← 返回功能目录" HorizontalAlignment="Left" Margin="18,12,0,6" Padding="15,7" FontSize="18" Click="BackToDirectory_Click"/>
            <views:SkuSerialLabelView Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
