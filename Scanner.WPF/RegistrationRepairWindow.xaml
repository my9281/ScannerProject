<Window x:Class="Scanner.WPF.RegistrationRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登记表修复" Width="680" Height="690" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#EAF3F7" FontFamily="{DynamicResource AppFontFamily}">
    <StackPanel Margin="28">
        <TextBlock Text="登记表修复" FontSize="28" FontWeight="Bold" Foreground="#082F4D"/>
        <TextBlock Text="仅处理亚马逊、eBay 收件登记工作表，合并导出一套数据。" TextWrapping="Wrap" Margin="0,12,0,14"/>
        <TextBlock Text="1. A 列日期统一格式，空白、备注等沿用本工作表上一条有效日期。" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="2. 规范机型大小写及空格；机型含字母、数字以外的字符且 F 列为“否”的记录删除。" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <Button x:Name="ImportButton" Content="选择登记表 Excel" Click="Import_Click" Width="180" Height="36" HorizontalAlignment="Left"/>
        <TextBlock x:Name="FileText" Text="未选择文件" TextTrimming="CharacterEllipsis" Margin="0,8,0,12"/>
        <TextBlock Text="导出：仓库收件日期、机型、SN、物流单号、退件类型、是否录入BT系统、售后系统收件日期、调拨单号/RMA号。" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusText" Text="请选择登记表。" TextWrapping="Wrap" Margin="0,14,0,0"/>
        <Button x:Name="ExportButton" Content="修复并导出 Excel" Click="Export_Click" IsEnabled="False" Width="180" Height="40" HorizontalAlignment="Right" Margin="0,18,0,0"/>
        <Separator Margin="0,18,0,14"/>
        <TextBlock Text="第二步：仓租检测" FontSize="21" FontWeight="Bold" Foreground="#082F4D"/>
        <TextBlock Text="按 SN 匹配基础表，仅输出基础表处理时间在所选年月的记录，并附上处理时间。" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBlock x:Name="BaseFileText" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="处理年份" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="YearBox" IsEditable="True" Width="110"/>
            <TextBlock Text="月份" VerticalAlignment="Center" Margin="18,0,8,0"/>
            <ComboBox x:Name="MonthBox" Width="80"/>
            <Button x:Name="WarehouseExportButton" Content="导出仓租检测" Click="WarehouseExport_Click" IsEnabled="False" Margin="20,0,0,0" Padding="12,8"/>
        </StackPanel>
    </StackPanel>
</Window>
