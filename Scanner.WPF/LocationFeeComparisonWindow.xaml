<Window x:Class="Scanner.WPF.LocationFeeComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LocationFeeTitle}" Width="760" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FB" FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F2F5FA"/><Setter Property="BorderBrush" Value="#DDE4F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource LocationFeeTitle}" FontSize="25" FontWeight="Bold" Foreground="#18243A"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,20" Foreground="#647089" TextWrapping="Wrap"
                   Text="{DynamicResource LocationFeeHint}"/>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE4F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource LocationFeeTemplate}"/>
                <TextBlock x:Name="TemplateFileTextBlock" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#647089" TextTrimming="CharacterEllipsis" Text="{DynamicResource NotSelected}"/>
                <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="{DynamicResource SelectTemplate}" Click="SelectTemplateButton_Click"/>
                <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource BaseWorkbook}"/>
                <TextBlock x:Name="BaseFileTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#647089" TextTrimming="CharacterEllipsis" Text="{DynamicResource NotSelected}"/>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="4,18,4,0" Foreground="#647089" Text="{DynamicResource SelectBothFiles}" TextWrapping="Wrap"/>
        <Button x:Name="ExportButton" Grid.Row="4" Height="44" MinWidth="160" HorizontalAlignment="Right"
                Padding="22,0" FontSize="15" FontWeight="SemiBold" Foreground="White" Background="#2457D6"
                BorderBrush="#2457D6" IsEnabled="False" Content="{DynamicResource GenerateComparison}" Click="ExportButton_Click"/>
    </Grid>
</Window>
