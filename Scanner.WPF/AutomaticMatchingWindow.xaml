<Window Icon="{DynamicResource Logo}" x:Class="Scanner.WPF.AutomaticMatchingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource WpfComplete001}" Width="1100" Height="650" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource WpfComplete002}" FontSize="18" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="FetchButton" Content="{DynamicResource WpfComplete003}" Click="Fetch_Click" Padding="20,8"/>
                <Button x:Name="ExportButton" Content="{DynamicResource WpfComplete004}" Click="Export_Click" IsEnabled="False" Padding="20,8" Margin="12,0,0,0"/>
                <Button x:Name="UploadButton" Content="{DynamicResource WpfComplete005}" Click="Upload_Click" IsEnabled="False" Padding="20,8" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{DynamicResource WpfComplete006}" Margin="0,12" TextWrapping="Wrap"/>
        </StackPanel>
        <DataGrid x:Name="ResultsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource PalletNumber}" Binding="{Binding PalletNumber}"/>
                <DataGridTextColumn Header="SN" Binding="{Binding Sn}"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}"/>
                <DataGridTextColumn Header="{DynamicResource WpfComplete007}" Binding="{Binding RmaNumber}"/>
                <DataGridTextColumn Header="{DynamicResource WpfComplete008}" Binding="{Binding ScanDate, StringFormat=yyyy-MM-dd}"/>
                <DataGridTextColumn Header="{DynamicResource WpfComplete009}" Binding="{Binding ScanTime, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                <DataGridTextColumn Header="{DynamicResource TypeColumn}" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="{DynamicResource WpfComplete010}" Binding="{Binding DetectionStatus}"/>
                <DataGridTextColumn Header="{DynamicResource WpfComplete011}" Binding="{Binding ProcessingTime}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
