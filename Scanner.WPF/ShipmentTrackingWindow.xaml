<Window x:Class="Scanner.WPF.ShipmentTrackingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:maps="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
 Icon="{DynamicResource Logo}" Title="{DynamicResource WpfSupplement7}" Width="1200" Height="800" MinWidth="900" MinHeight="600"
 WindowStartupLocation="CenterOwner" Background="#EAF3F7" Loaded="Window_Loaded">
 <Grid Margin="20">
  <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="White" CornerRadius="8" Padding="16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource WpfSupplement8}" FontSize="24" FontWeight="Bold" Foreground="#082F4D" Margin="0,0,0,14"/>
    <ListBox x:Name="ShipmentList" Grid.Row="1" SelectionChanged="ShipmentList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6" Width="240">
      <TextBlock Text="{Binding Number}" FontSize="17" FontWeight="Bold"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#315D7A" Margin="0,5,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="{DynamicResource WpfSupplement9}" TextWrapping="Wrap" Margin="0,14,0,8"/>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="TrackingInput" FontSize="18" Padding="8" VerticalContentAlignment="Center" KeyDown="TrackingInput_KeyDown"/>
     <Button x:Name="ConfirmButton" Grid.Column="1" Content="{DynamicResource WpfSupplement10}" Padding="16,8" Margin="8,0,0,0" Click="Confirm_Click"/>
    </Grid>
   </Grid>
  </Border>
  <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"/>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="180"/></Grid.RowDefinitions>
   <TextBlock x:Name="StatusText" Text="{DynamicResource WpfSupplement11}" TextWrapping="Wrap" Foreground="#082F4D" Margin="0,0,0,10"/>
   <maps:MapControl x:Name="TrackingMap" Grid.Row="1"/>
   <Border Grid.Row="1" Background="#EFFFFFFF" Padding="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"><TextBlock Text="© OpenStreetMap contributors" FontSize="12"/></Border>
   <ListBox x:Name="EventList" Grid.Row="2" Margin="0,12,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="6"/></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
 </Grid>
</Window>
