<Window x:Class="Scanner.WPF.BatchLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量打印标签" Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#EAF3F7" FontFamily="{DynamicResource AppFontFamily}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="批量打印标签" FontSize="28" FontWeight="Bold" Foreground="#082F4D"/>
            <TextBlock Text="导入 Excel，按数量打印 4 × 6 横向 SKU/SN 双二维码标签。报废标签在顶层画 X，并显示中英西三语报废标识。" TextWrapping="Wrap" Margin="0,8,0,12"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <Button x:Name="ImportButton" Content="导入 Excel" Click="Import_Click" Padding="18,8" DockPanel.Dock="Left"/>
            <TextBlock x:Name="FileText" Text="未导入文件" TextTrimming="CharacterEllipsis" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Selection_Changed" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" Width="40"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="180"/>
                    <DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="190"/>
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="45"/>
                    <DataGridTextColumn Header="处理" Binding="{Binding Treatment}" Width="60"/>
                    <DataGridTextColumn Header="标签备注" Binding="{Binding LabelRemark}" Width="150"/>
                    <DataGridTextColumn Header="打印状态" Binding="{Binding PrintStatus}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="所选标签预览" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border BorderBrush="#79A9C4" BorderThickness="1" Background="White"><Image x:Name="PreviewImage" Stretch="Uniform" Height="240"/></Border>
                <TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="报废标签会覆盖原备注；空 SKU/SN 或无效数量的行会显示原因并跳过。已发送的标签不会在本批次继续打印时重复发送。" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="请先导入文件。" TextWrapping="Wrap"/>
            <ProgressBar x:Name="PrintProgress" Height="10" Margin="0,8,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="停止后续打印" IsEnabled="False" Click="Cancel_Click" Padding="18,9" Margin="0,0,12,0"/>
                <Button x:Name="PrintButton" Content="批量打印标签" IsEnabled="False" Click="Print_Click" Padding="20,9"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
