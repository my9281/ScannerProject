<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="WindowTitle">幽梦运单之星扫描系统</system:String>

    <system:String x:Key="MainTitle">幽梦运单之星扫描系统</system:String>

    <system:String x:Key="ScanInputTitle">扫描或输入编码</system:String>

    <system:String x:Key="AutoPrint">自动打印</system:String>

    <system:String x:Key="PrintTwoCopies">打印</system:String>

    <system:String x:Key="OpenScanLog">打开扫描记录</system:String>

    <system:String x:Key="RuntimeInformation">运行信息</system:String>

    <system:String x:Key="LabelInformation">标签：6 × 4 英寸，横向</system:String>

    <system:String x:Key="CopiesInformation">每个编码：打印一份</system:String> 
    <system:String x:Key="ReadingPrinter">默认打印机：正在读取</system:String> 
    <system:String x:Key="DefaultPrinter">默认打印机：{0}</system:String> 
    <system:String x:Key="PrinterNotFound">默认打印机：未找到</system:String> 
    <system:String x:Key="LogFile">记录文件：</system:String> 
    <system:String x:Key="LogFileValue">记录文件：{0}</system:String> 
    <system:String x:Key="ScanCountZero">本次运行已扫描：0</system:String> 
    <system:String x:Key="ScanCount">本次运行已扫描：{0}</system:String> 
    <system:String x:Key="WaitingForScan">等待扫描</system:String>

    <system:String x:Key="ScannerHelp">扫码枪需要设置为 HID Keyboard，并在扫码后发送 Enter。</system:String>

    <system:String x:Key="Processing">正在处理：{0}</system:String>

    <system:String x:Key="EmptyCode">编码不能为空，请重新扫描。</system:String>

    <system:String x:Key="BusyProcessing">上一条编码仍在处理中，请稍后再扫。</system:String>

    <system:String x:Key="SavedAndPrinted">已保存记录并提交两份打印：{0}</system:String>

    <system:String x:Key="SavedWithoutPrint">已保存扫描记录，未打印：{0}</system:String>

    <system:String x:Key="ProcessFailed">处理失败：{0}</system:String>

    <system:String x:Key="OpenLogFailed">无法打开扫描记录：{0}</system:String>

</ResourceDictionary>
