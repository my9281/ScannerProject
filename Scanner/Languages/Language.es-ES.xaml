<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="WindowTitle">Sistema de Escaneo YM-Star</system:String>

    <system:String x:Key="MainTitle">Sistema de Escaneo YM-Star</system:String>

    <system:String x:Key="ScanInputTitle">Escanee o ingrese un código</system:String>

    <system:String x:Key="AutoPrint">Impresión automática</system:String>

    <system:String x:Key="PrintTwoCopies">Imprimir</system:String>

    <system:String x:Key="OpenScanLog">Abrir registro</system:String>

    <system:String x:Key="RuntimeInformation">Información de ejecución</system:String>

    <system:String x:Key="LabelInformation">Etiqueta: 6 × 4 pulgadas, horizontal</system:String>

    <system:String x:Key="CopiesInformation">Copias por código: 1</system:String>

    <system:String x:Key="ReadingPrinter">Impresora predeterminada: Leyendo</system:String>

    <system:String x:Key="DefaultPrinter">Impresora predeterminada: {0}</system:String>

    <system:String x:Key="PrinterNotFound">Impresora predeterminada: No encontrada</system:String>

    <system:String x:Key="LogFile">Archivo de registro:</system:String>

    <system:String x:Key="LogFileValue">Archivo de registro: {0}</system:String>

    <system:String x:Key="ScanCountZero">Escaneados en esta sesión: 0</system:String>

    <system:String x:Key="ScanCount">Escaneados en esta sesión: {0}</system:String>

    <system:String x:Key="WaitingForScan">Esperando escaneo</system:String>

    <system:String x:Key="ScannerHelp">Configure el escáner como teclado HID y envíe Enter después de cada escaneo.</system:String>

    <system:String x:Key="Processing">Procesando: {0}</system:String>

    <system:String x:Key="EmptyCode">El código no puede estar vacío. Escanee nuevamente.</system:String>

    <system:String x:Key="BusyProcessing">El código anterior todavía se está procesando. Espere.</system:String>

    <system:String x:Key="SavedAndPrinted">Registro guardado y dos copias enviadas: {0}</system:String>

    <system:String x:Key="SavedWithoutPrint">Escaneo guardado sin imprimir: {0}</system:String>

    <system:String x:Key="ProcessFailed">Error de procesamiento: {0}</system:String>

    <system:String x:Key="OpenLogFailed">No se pudo abrir el registro: {0}</system:String>

</ResourceDictionary>
