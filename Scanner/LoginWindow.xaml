<Window x:Class="Scanner.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scanner"
        mc:Ignorable="d"
      Title="登录"
        Width="460"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Background="#F4F4F4">

        <Border Margin="15"
            Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="维修系统登录"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBlock Grid.Row="1"
                           Text="用户名"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="UsernameTextBox"
                         Grid.Row="2"
                         Height="44"
                         Padding="10,0"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,18"
                         KeyDown="Input_KeyDown"/>

                <TextBlock Grid.Row="3"
                           Text="密码"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordInput"
                             Grid.Row="4"
                             Height="44"
                             Padding="10,0"
                             FontSize="18"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,14"
                             KeyDown="Input_KeyDown"/>

                <CheckBox x:Name="RememberPasswordCheckBox"
                          Grid.Row="5"
                          Content="记住密码"
                          FontSize="15"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,20"/>

                <Button x:Name="LoginButton"
                        Grid.Row="6"
                        Content="登录"
                        Height="46"
                        FontSize="18"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="7"
                           Text=""
                           FontSize="14"
                           Foreground="DarkRed"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,18,0,0"/>

            </Grid>
        </Border>
    </Grid>
</Window>