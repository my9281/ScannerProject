<Window x:Class="Scanner.LocationFeeComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="库位付费比对" Width="760" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F2F5FA"/><Setter Property="BorderBrush" Value="#DDE4F0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="库位付费比对" FontSize="25" FontWeight="Bold" Foreground="#18243A"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,20" Foreground="#647089" TextWrapping="Wrap"
                   Text="导入两个 sheet 的模板和 InboundDetection 基础表。系统将补全 A 列日期、删除图片，并按 C 列 SN 把处理时间和处理结果写入 I、J 列。"/>
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE4F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="库位付费模板"/>
                <TextBlock x:Name="TemplateFileTextBlock" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#647089" TextTrimming="CharacterEllipsis" Text="尚未选择"/>
                <Button Grid.Column="2" Style="{StaticResource ActionButton}" Content="选择模板" Click="SelectTemplateButton_Click"/>
                <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="基础表"/>
                <TextBlock x:Name="BaseFileTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#647089" TextTrimming="CharacterEllipsis" Text="尚未选择"/>
                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ActionButton}" Content="选择基础表" Click="SelectBaseButton_Click"/>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusTextBlock" Grid.Row="3" Margin="4,18,4,0" Foreground="#647089" Text="请选择模板和基础表。" TextWrapping="Wrap"/>
        <Button x:Name="ExportButton" Grid.Row="4" Height="44" MinWidth="160" HorizontalAlignment="Right"
                Padding="22,0" FontSize="15" FontWeight="SemiBold" Foreground="White" Background="#2457D6"
                BorderBrush="#2457D6" IsEnabled="False" Content="生成比对结果" Click="ExportButton_Click"/>
    </Grid>
</Window>
