<Window x:Class="Scanner.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{DynamicResource Logo}" Title="{DynamicResource ChecklistTitle}"
        Width="920" Height="690" MinWidth="860" MinHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F3F6FB" FontFamily="{DynamicResource AppFontFamily}">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2457D6"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18243A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#647089"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE4F0"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.08" Color="#15223A"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="18,0"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#F2F5FA"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,24">
            <StackPanel>
                <TextBlock Text="{DynamicResource ChecklistTitle}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource ChecklistHint}" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E8EEFC" CornerRadius="16" Padding="12,6">
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#35B879" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource LocalCacheBadge}" Foreground="#3A527C" FontSize="12"/></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource ImportSnStep}" Style="{StaticResource ActionButton}" Margin="0,0,12,0" Click="ImportSnButton_Click"/>
            <Button x:Name="ExportButton" Grid.Column="1" Content="{DynamicResource ExportMatchStep}" Style="{StaticResource ActionButton}" Margin="0,0,12,0" Click="ExportButton_Click" IsEnabled="False"/>
            <Button x:Name="ExportSimplifiedButton" Grid.Column="2" Content="{DynamicResource ExportSimplified}" Style="{StaticResource ActionButton}" Margin="0,0,12,0" Click="ExportSimplifiedButton_Click" IsEnabled="False"/>
            <Button x:Name="ExportCurrentMonthButton" Grid.Column="3" Content="{DynamicResource ExportMonthPending}" Style="{StaticResource ActionButton}" Click="ExportCurrentMonthButton_Click" IsEnabled="False"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource ProcessingSummary}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                <DataGrid x:Name="StatusSummaryDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                          FontSize="13" RowHeight="36" ColumnHeaderHeight="38" Background="White" AlternatingRowBackground="#F8FAFD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Category}" Binding="{Binding Category}" Width="180"/>
                        <DataGridTextColumn x:Name="CurrentMonthColumn" Header="{DynamicResource CurrentMonth}" Binding="{Binding CurrentMonthDisplay}" Width="135"/>
                        <DataGridTextColumn x:Name="PreviousMonthColumn" Header="{DynamicResource PreviousMonth}" Binding="{Binding PreviousMonthDisplay}" Width="135"/>
                        <DataGridTextColumn x:Name="TwoMonthsAgoColumn" Header="{DynamicResource TwoMonthsAgo}" Binding="{Binding TwoMonthsAgoDisplay}" Width="135"/>
                        <DataGridTextColumn Header="{DynamicResource Remaining}" Binding="{Binding RemainingDisplay}" Width="115"/>
                        <DataGridTextColumn Header="{DynamicResource Total}" Binding="{Binding TotalDisplay}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{DynamicResource StatisticsHint}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource CacheStatus}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Grid.Row="1" Margin="0,17,0,16">
                    <TextBlock x:Name="BaseStatusTextBlock" Text="{DynamicResource BaseNotImported}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="BaseFileTextBlock" Margin="0,7,0,0" FontSize="12" Foreground="#8B96AA" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="2" Background="#E9EDF4"/>
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock x:Name="SnStatusTextBlock" Text="{DynamicResource SnNotImported}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="SnFileTextBlock" Margin="0,7,0,0" FontSize="12" Foreground="#8B96AA" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="4" Margin="0,20,0,0" Background="#E9EEF7" CornerRadius="9" Padding="13,9">
                    <TextBlock Text="{DynamicResource CacheHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
