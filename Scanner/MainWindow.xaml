<Window x:Class="Scanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Scanner"
        mc:Ignorable="d"
        Icon="{DynamicResource Logo}"
        Title="{DynamicResource WindowTitle}"
        MinWidth="700" 
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Background="#F4F4F4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75*"/>
            <ColumnDefinition Width="272*"/>
        </Grid.ColumnDefinitions> 
        <Border Margin="20" 
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8" Grid.ColumnSpan="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部标题和语言按钮 -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="OperatorTextBlock"
                               Text="{Binding OperatorText}"
                               FontSize="14"
                               HorizontalAlignment="Left"/>
                    <!-- 中间标题 -->
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource MainTitle}"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- 右上角语言按钮 -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">

                        <Button Content="中"
                                Width="42"
                                Height="30"
                                Margin="0,0,5,0"
                                FontSize="14"
                                ToolTip="中文"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="zh-CN"/>

                        <Button Content="EN"
                                Width="42"
                                Height="30"
                                Margin="0,0,5,0"
                                FontSize="13"
                                ToolTip="English"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="en-US"/>

                        <Button Content="ES"
                                Width="42"
                                Height="30"
                                FontSize="13"
                                ToolTip="Español"
                                Command="{Binding ChangeLanguageCommand}"
                                CommandParameter="es-ES"/>

                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{DynamicResource ScanInputTitle}"
                           FontSize="17"
                           HorizontalAlignment="Left"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="SnTextBox"
                         Grid.Row="2"
                         Height="58"
                         Padding="12,0"
                         FontSize="27"
                         FontWeight="SemiBold"
                         Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsInputEnabled}"
                         GotKeyboardFocus="ScanTextBox_GotKeyboardFocus"
                         VerticalContentAlignment="Center"
                         InputMethod.IsInputMethodEnabled="False">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ProcessScanCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,20">

                    <CheckBox IsChecked="{Binding IsPrint, Mode=TwoWay}"
                              VerticalContentAlignment="Center"
                              Content="{DynamicResource AutoPrint}"
                              Margin="0,0,10,0"
                              FontSize="22"/>

                    <Button x:Name="PrintButton"
                            Content="{DynamicResource PrintTwoCopies}"
                            Width="150"
                            Height="45"
                            Margin="0,0,12,0"
                            FontSize="17"
                            Command="{Binding ProcessScanCommand}"/>

                    <Button x:Name="OpenLogButton"
                            Content="{DynamicResource OpenScanLog}"
                            Width="150"
                            Height="45"
                            FontSize="17"
                            Command="{Binding OpenLogCommand}"/>

                </StackPanel>

                <Border Grid.Row="4"
                        Padding="20"
                        Background="#FAFAFA"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="5">

                    <StackPanel>

                        <TextBlock Text="{DynamicResource RuntimeInformation}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{DynamicResource LabelInformation}"
                                   FontSize="15"
                                   Margin="0,3"/>

                        <TextBlock Text="{DynamicResource CopiesInformation}"
                                   FontSize="15"
                                   Margin="0,3"/>

                        <TextBlock x:Name="PrinterTextBlock"
                                   Text="{Binding PrinterText}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Margin="0,3"/>

                        <TextBlock x:Name="LogFileTextBlock"
                                   Text="{Binding LogFileText}"
                                   FontSize="14" 
                                   TextWrapping="Wrap"
                                   Margin="0,3"/>

                        <TextBlock x:Name="CountTextBlock"
                                   Text="{Binding CountText}"
                                   FontSize="15"
                                   Margin="0,3"/>

                        <TextBlock x:Name="StatusTextBlock"
                                   Text="{Binding StatusText}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{Binding StatusBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"/>

                    </StackPanel>
                </Border>
                <Border  Grid.Row="5" Height="30" Margin="20,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions> 
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Text="状态："
                           Foreground="#666666" 
                                       FontSize="15"/>
                            <TextBlock Foreground="#666666" 
                                       x:Name="WebStatus"
                                       Text="{Binding WebStatus}"
                                       FontSize="15" />
                            <TextBlock Text="刷新时间："
                                       Foreground="#666666" 
                                       FontSize="15"/>
                            <TextBlock  Foreground="#666666" 
                                        x:Name="WebLastTime"
                                        Text="{Binding WebLastTime}"
                                        FontSize="15" />

                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ImportCsvButton"
        Content="导入紧急 CSV" 
        Margin="0,0,12,0" 
                                    Padding="5,0"
        Command="{Binding ImportCsvCommand}"/>
                            <Button 
                                Command="{Binding RefreshCommand}"
                                    Padding="5,0"
                                Content="手动刷新"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
