<Window x:Class="Scanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="{DynamicResource Logo}"
        Title="{DynamicResource WindowTitle}"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="620"
        Background="#F3F6FB"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2457D6"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D46AE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18243A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#647089"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DDE4F0"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.08" Color="#15223A"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#F2F5FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="LanguageButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#E8EEFC" CornerRadius="16" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#35B879" Margin="0,0,8,0"/>
                    <TextBlock x:Name="OperatorTextBlock" Text="{Binding OperatorText}" Foreground="#3A527C" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource MainTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="SCAN  ·  VERIFY  ·  PRINT" Foreground="#8B96AA" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="中" ToolTip="中文" Style="{StaticResource LanguageButtonStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="zh-CN"/>
                <Button Content="EN" ToolTip="English" Style="{StaticResource LanguageButtonStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="en-US"/>
                <Button Content="ES" ToolTip="Español" Style="{StaticResource LanguageButtonStyle}" Command="{Binding ChangeLanguageCommand}" CommandParameter="es-ES"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <TextBlock Text="{DynamicResource ScanInputTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="扫码后按 Enter 自动处理" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" Background="#F8FAFD" BorderBrush="#9CB5F5" BorderThickness="2" CornerRadius="10">
                    <TextBox x:Name="SnTextBox"
                             Height="64"
                             Padding="16,0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource PrimaryBrush}"
                             FontFamily="Consolas"
                             FontSize="27"
                             FontWeight="SemiBold"
                             Text="{Binding ScanCode, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsInputEnabled}"
                             GotKeyboardFocus="ScanTextBox_GotKeyboardFocus"
                             VerticalContentAlignment="Center"
                             InputMethod.IsInputMethodEnabled="False">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ProcessScanCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>
                <Grid Grid.Row="2" Margin="2,16,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsPrint, Mode=TwoWay}" Content="{DynamicResource AutoPrint}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="OpenLogButton" Content="{DynamicResource OpenScanLog}" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0" Command="{Binding OpenLogCommand}"/>
                        <Button x:Name="PrintButton" Content="{DynamicResource PrintTwoCopies}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="132" Command="{Binding ProcessScanCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource RuntimeInformation}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource LabelInformation}" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Text="{DynamicResource CopiesInformation}" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="PrinterTextBlock" Text="{Binding PrinterText}" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock x:Name="LogFileTextBlock" Text="{Binding LogFileText}" Style="{StaticResource InfoLabelStyle}"/>
                    <Border Height="1" Background="#E9EDF4" Margin="0,10"/>
                    <TextBlock x:Name="CountTextBlock" Text="{Binding CountText}" Foreground="{StaticResource PrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,3"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22" Margin="9,0,0,0" BorderBrush="{Binding StatusBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="处理状态" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Ellipse Width="11" Height="11" Fill="{Binding StatusBrush}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#E9EEF7" CornerRadius="11" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#35B879" Margin="0,0,8,0"/>
                    <TextBlock Text="服务状态" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WebStatus" Text="{Binding WebStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="6,0,18,0" VerticalAlignment="Center"/>
                    <TextBlock Text="最近刷新" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WebLastTime" Text="{Binding WebLastTime}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ImportCsvButton" Content="导入紧急 CSV" Style="{StaticResource BaseButtonStyle}" Height="34" Margin="0,0,8,0" Command="{Binding ImportCsvCommand}"/>
                    <Button Content="手动刷新" Style="{StaticResource BaseButtonStyle}" Height="34" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
