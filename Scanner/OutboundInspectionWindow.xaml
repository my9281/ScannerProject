<Window x:Class="Scanner.OutboundInspectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="{DynamicResource Logo}" Title="出库检测" Width="1120" Height="720" MinWidth="1020" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F3F6FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2457D6"/><SolidColorBrush x:Key="TextPrimaryBrush" Color="#18243A"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="#647089"/><SolidColorBrush x:Key="BorderBrush" Color="#DDE4F0"/>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="16,0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#F2F5FA"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="3,0,3,16"><TextBlock Text="出库检测" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Text="读取 TXT 中的 SKU/SN，匹配基础表；同一批数据既可导出明细，也可汇总 SKU 打印托盘核对标签。" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="TextFileTextBlock" Text="尚未选择 SKU/SN TXT（第一行 SKU，第二行 SN）" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="BaseFileTextBlock" Text="尚未选择 InboundDetection 基础表" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
            <Button Grid.Column="1" Content="选择 TXT" Style="{StaticResource ActionButton}" Margin="0,0,10,0" Click="SelectTextButton_Click"/><Button Grid.Column="2" Content="选择基础表" Style="{StaticResource ActionButton}" Click="SelectBaseButton_Click"/>
        </Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="托盘号" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,6"/><TextBox x:Name="PalletNumberTextBox" Height="42" FontSize="16" Padding="10,7"/></StackPanel>
            <Button x:Name="PrintButton" Grid.Column="1" Content="汇总 SKU 并打印 4×6" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Margin="0,0,10,0" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="PrintButton_Click" IsEnabled="False"/>
            <Button x:Name="ExportButton" Grid.Column="2" Content="导出明细 XLSX" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Background="{StaticResource PrimaryBrush}" Foreground="White" Click="ExportButton_Click" IsEnabled="False"/>
        </Grid></Border>
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="SummaryTextBlock" Text="请选择 TXT 和基础表" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <DataGrid x:Name="ResultDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" RowHeight="34" AlternatingRowBackground="#F8FAFD"><DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Number}" Width="65"/><DataGridTextColumn Header="SN" Binding="{Binding Sn}" Width="190"/><DataGridTextColumn Header="SKU（TXT）" Binding="{Binding Sku}" Width="250"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="处理方式" Binding="{Binding ProcessingMethod}" Width="120"/><DataGridTextColumn Header="处理日期" Binding="{Binding ProcessingTime}" Width="*"/>
            </DataGrid.Columns></DataGrid>
        </Grid></Border>
    </Grid>
</Window>
