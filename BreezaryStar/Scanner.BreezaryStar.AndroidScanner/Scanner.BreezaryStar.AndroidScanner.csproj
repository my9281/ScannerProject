<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Scanner.BreezaryStar.AndroidScanner</RootNamespace>
    <UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>风扇PDA</ApplicationTitle>
    <ApplicationId>com.scanner.breezarystar.androidscanner</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\brand_logo.png" ForegroundScale="0.65" Color="#FFFFFF" />
    <MauiSplashScreen Include="Resources\AppIcon\brand_logo.png" Color="#080A0C" BaseSize="160,160" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <Compile Include="..\..\Scanner.Server.Model\BreezaryInboundScan.cs" Link="Contracts\BreezaryInboundScan.cs" />
  </ItemGroup>
  <Import Project="..\..\build\MauiPackageSize.targets" />
</Project>
