<metadata>
  <!-- The JAR exposes duplicate empty listener declarations. Keep the declarations
       with callbacks so generated Java implementors satisfy the SDK interfaces. -->
  <remove-node path="/api/package[@name='com.rt.printerlibrary.utils']/interface[@name='ConnectListener' and not(method)]" />
  <remove-node path="/api/package[@name='com.rt.printerlibrary.utils']/interface[@name='PrintListener' and not(method)]" />
  <!-- Java covariant factory returns must match the abstract .NET base signature. -->
  <attr path="/api/package[@name='com.rt.printerlibrary.cmd']/class[contains(@name,'Factory')]/method[@name='create']" name="managedReturn">Com.RT.Printerlibrary.Cmd.Cmd</attr>
  <!-- Internal USB driver enum is package-private and is not part of Bluetooth integration. -->
  <remove-node path="/api/package[@name='com.rt.printerlibrary.driver.usb.rw']/class[@name='PL2303Driver']/field" />
</metadata>
