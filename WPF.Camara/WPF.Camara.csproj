<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="ZXing.Net" Version="0.16.11" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Data/ReceivingForecast.tsv" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Data/LooseGoods1.tsv" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Data/LooseGoods2.tsv" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Data/label-data.json" /></ItemGroup>
  <ItemGroup>
    <None Update="Data/history/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Scanner.Server.Model/RepairScan.cs" Link="Contracts/RepairScan.cs" />
    <None Update="repair-upload.xml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

