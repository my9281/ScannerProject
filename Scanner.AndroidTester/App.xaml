<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Scanner.AndroidTester.App">
 <Application.Resources>
  <ResourceDictionary>
   <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="#080A0C"/></Style>
   <Style TargetType="Label"><Setter Property="TextColor" Value="#F2F2F2"/></Style>
   <Style TargetType="Entry"><Setter Property="TextColor" Value="#F2F2F2"/><Setter Property="PlaceholderColor" Value="#92979D"/><Setter Property="BackgroundColor" Value="#181C20"/></Style>
   <Style TargetType="Button">
    <Setter Property="TextColor" Value="#F2F2F2"/><Setter Property="BackgroundColor" Value="#181C20"/>
    <Setter Property="BorderColor" Value="#363C42"/><Setter Property="BorderWidth" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,10"/>
    <Setter Property="VisualStateManager.VisualStateGroups"><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="Pressed"><VisualState.Setters><Setter Property="Opacity" Value="0.7"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Setter>
   </Style>
   <Style TargetType="NavigationPage"><Setter Property="BarBackgroundColor" Value="#080A0C"/><Setter Property="BarTextColor" Value="#F2F2F2"/></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
