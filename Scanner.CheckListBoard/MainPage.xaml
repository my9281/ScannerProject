<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scanner.CheckListBoard.MainPage" Shell.NavBarIsVisible="False" BackgroundColor="#E5F2FA">

    <Grid>
        <GraphicsView x:Name="PorcelainBackground" InputTransparent="True" />
        <ScrollView>
            <VerticalStackLayout Padding="24,42,24,28" Spacing="24" MaximumWidthRequest="760" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="8">
                    <Label Text="壹 仓 · 检 测" FontSize="12" CharacterSpacing="4" TextColor="#527FA1" />
                    <Label Text="检测工作台" FontSize="32" FontAttributes="Bold" TextColor="#183F64" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="以严谨守品质，以匠心见真章" FontSize="14" TextColor="#6286A2" />
                    <BoxView HeightRequest="2" WidthRequest="44" Color="#6D9BBE" HorizontalOptions="Start" Margin="0,8,0,0" />
                </VerticalStackLayout>
                <Grid x:Name="ModuleGrid" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="14" />
                <Label Text="深圳· 壹合国际" FontSize="12" CharacterSpacing="2" TextColor="#6A8EA9" HorizontalTextAlignment="Center" Margin="0,6" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
