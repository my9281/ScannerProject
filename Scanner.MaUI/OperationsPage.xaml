<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scanner.MaUI.OperationsPage"
             Title="检测工具" BackgroundColor="#F3F6FB">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="920" HorizontalOptions="Fill">
            <Label Text="检测与比对" FontSize="26" FontAttributes="Bold" TextColor="#18243A" />
            <Label Text="文件处理逻辑与 Windows Scanner 保持一致；生成结果后可保存或分享。" TextColor="#647089" />

            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Button Text="导入 / 更换全局基础表" Clicked="PickInboundBase_Clicked" />
                    <Label x:Name="GlobalBaseLabel" LineBreakMode="WordWrap" />
                    <Label Text="入库、出库、库位费比对共用；关闭程序后需重新导入。" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="入库检测" FontSize="18" FontAttributes="Bold" />
                    <Button Text="选择待匹配 SN 文本" Clicked="PickInboundSn_Clicked" />
                    <Label x:Name="InboundSnLabel" Text="尚未选择" LineBreakMode="MiddleTruncation" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="导出匹配结果" Clicked="ExportInboundMatch_Clicked" />
                        <Button Text="导出本月待检测" Clicked="ExportCurrentMonth_Clicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="InboundStatusLabel" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="出库检测" FontSize="18" FontAttributes="Bold" />
                    <Button Text="选择 SKU / SN 文本" Clicked="PickOutboundText_Clicked" />
                    <Label x:Name="OutboundTextLabel" Text="尚未选择" LineBreakMode="MiddleTruncation" />
                    <Button Text="导出出库检测 Excel" Clicked="ExportOutbound_Clicked" />
                    <Label x:Name="OutboundStatusLabel" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="库位费比对" FontSize="18" FontAttributes="Bold" />
                    <Button Text="选择库位费模板 Excel" Clicked="PickFeeTemplate_Clicked" />
                    <Label x:Name="FeeTemplateLabel" Text="尚未选择" LineBreakMode="MiddleTruncation" />
                    <Button Text="生成库位费比对结果" Clicked="ExportFee_Clicked" />
                    <Label x:Name="FeeStatusLabel" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
