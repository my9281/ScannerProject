<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scanner.MaUI.OperationsPage"
             Title="{DynamicResource OperationsTitle}" BackgroundColor="#F3F6FB">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="920" HorizontalOptions="Fill">
            <Label Text="{DynamicResource OperationsHeading}" FontSize="26" FontAttributes="Bold" TextColor="#18243A" />
            <Label Text="{DynamicResource OperationsHint}" TextColor="#647089" />

            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Button Text="{DynamicResource OperationsImportBase}" Clicked="PickInboundBase_Clicked" />
                    <Label x:Name="GlobalBaseLabel" LineBreakMode="WordWrap" />
                    <Label Text="{DynamicResource OperationsBaseHint}" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource InboundTitle}" FontSize="18" FontAttributes="Bold" />
                    <Button Text="{DynamicResource OperationsSelectInboundSn}" Clicked="PickInboundSn_Clicked" />
                    <Label x:Name="InboundSnLabel" Text="{DynamicResource OperationsNotSelected}" LineBreakMode="MiddleTruncation" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="{DynamicResource OperationsExportMatch}" Clicked="ExportInboundMatch_Clicked" />
                        <Button Text="{DynamicResource OperationsExportPending}" Clicked="ExportCurrentMonth_Clicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="InboundStatusLabel" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource OutboundTitle}" FontSize="18" FontAttributes="Bold" />
                    <Button Text="{DynamicResource SelectSkuSnTitle}" Clicked="PickOutboundText_Clicked" />
                    <Label x:Name="OutboundTextLabel" Text="{DynamicResource OperationsNotSelected}" LineBreakMode="MiddleTruncation" />
                    <Entry x:Name="PalletNumberEntry" Placeholder="{DynamicResource PalletNumber}" MaxLength="100" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="{DynamicResource ExportOutboundTitle}" Clicked="ExportOutbound_Clicked" />
                        <Button x:Name="UploadPalletButton" Grid.Column="1" Text="{DynamicResource UploadShelvedPallet}" Clicked="UploadPallet_Clicked" BackgroundColor="#16835D" TextColor="White" IsEnabled="False" />
                    </Grid>
                    <Label x:Name="OutboundStatusLabel" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="White" Stroke="#DDE4F0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource LocationFeeTitle}" FontSize="18" FontAttributes="Bold" />
                    <Button Text="{DynamicResource SelectFeeTemplateTitle}" Clicked="PickFeeTemplate_Clicked" />
                    <Label x:Name="FeeTemplateLabel" Text="{DynamicResource OperationsNotSelected}" LineBreakMode="MiddleTruncation" />
                    <Button Text="{DynamicResource OperationsExportFee}" Clicked="ExportFee_Clicked" />
                    <Label x:Name="FeeStatusLabel" TextColor="#647089" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
