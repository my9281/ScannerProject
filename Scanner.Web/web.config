<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Scanner.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
  <location path="api/updates/wpf">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="537919488" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
